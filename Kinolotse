async function diagnose(){
  var out = $("diagOut");
  if (!out) return;
  out.innerHTML = "";
  $("diagRun").disabled = true;
  function add(txt, cls){
    var d = document.createElement("div");
    d.className = "muted";
    d.innerHTML = '<span class="tag ' + (cls||"") + '">' + esc(txt) + '</span>';
    out.appendChild(d);
  }

  for (var i=0;i<S.readers.length;i++){
    try {
      var t = await fetchOnce("https://filmpalast.to/", S.readers[i].tpl, 45000);
      var ok = t.length > 500;
      add("Reader " + (i+1) + ": " + (ok ? "ok" : "leer"), ok ? "ok" : "bad");
      rh[i] = (rh[i]||0) + (ok ? 3 : -3);
    } catch(e){ add("Reader " + (i+1) + ": " + e.message, "bad"); rh[i] = (rh[i]||0) - 3; }
  }
  writeLS(K.r, rh);

  for (var p=0;p<S.proxies.length;p++){
    try {
      var t2 = await fetchOnce("https://example.com", S.proxies[p].tpl, 15000);
      var ok2 = t2.indexOf("Example") !== -1;
      add("Proxy " + (p+1) + ": " + (ok2 ? "ok" : "falscher Inhalt"), ok2 ? "ok" : "bad");
      ph[p] = (ph[p]||0) + (ok2 ? 3 : -3);
    } catch(e2){ add("Proxy " + (p+1) + ": " + e2.message, "bad"); ph[p] = (ph[p]||0) - 3; }
  }
  writeLS(K.p, ph);

  for (var q=0;q<S.providers.length;q++){
    var pr = S.providers[q];
    try {
      var hits = await searchProvider(pr, "Inception", {log:[]});
      add(pr.name + ": " + hits.length + " Treffer", hits.length ? "ok" : "bad");
      if (hits.length){ pr.enabled = true; pr.fails = 0; }
      provResult(pr.key, hits.length > 0);
    } catch(e3){ add(pr.name + ": " + e3.message, "bad"); provResult(pr.key, false); }
  }
  writeLS(K.s, S);
  drawLearn();
  drawSettings();
  $("diagRun").disabled = false;
  setStatus("Diagnose fertig");
}

