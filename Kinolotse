function drawLearn(){
  var box = $("learnOut");
  if (!box) return;
  var keys = Object.keys(stats).filter(function(k){ return stats[k].ok + stats[k].fail >= 2; });
  keys.sort(function(a,b){ return (stats[b].ok+stats[b].fail) - (stats[a].ok+stats[a].fail); });
  keys = keys.slice(0, 40);
  if (!keys.length){ box.innerHTML = '<p class="muted">noch keine Daten</p>'; return; }
  var html = "<table>";
  keys.forEach(function(k){
    var v = stats[k], q = v.ok / (v.ok + v.fail);
    html += "<tr><td>" + esc(k.replace("|"," / ")) + '</td><td><span class="tag ' + (q >= 0.5 ? "ok" : "bad") + '">' + Math.round(q*100) + '%</span></td></tr>';
  });
  box.innerHTML = html + "</table>";
}

