      setStatus("gespeichert");
    });
    $("provList").addEventListener("click", function(ev){
      var t = ev.target.closest("[data-toggle]"), d = ev.target.closest("[data-del]");
      if (t){ S.providers[+t.dataset.toggle].enabled = !S.providers[+t.dataset.toggle].enabled; writeLS(K.s, S); drawSettings(); }
      if (d){ S.providers.splice(+d.dataset.del, 1); writeLS(K.s, S); drawSettings(); }
    });
    $("np_add").addEventListener("click", function(){
      var n = $("np_name").value.trim(), b = $("np_base").value.trim(), s = $("np_search").value.trim(), m = $("np_must").value.trim();
      if (!n || !isHttp(b) || s.indexOf("{q}") === -1 || !m){ setStatus("Angaben fehlen", true); return; }
      S.providers.push({ key:n.toLowerCase().replace(/\W+/g,""), name:n, base:b, search:s, must:m, enabled:true, fails:0 });
      writeLS(K.s, S);
      $("np_name").value = $("np_base").value = $("np_search").value = $("np_must").value = "";
      drawSettings();
      setStatus("Portal ergänzt");
    });
  });

  safe("Klicks", function(){
    document.addEventListener("click", function(ev){
      var c = ev.target.closest("[data-cancel]");
      if (c){ var j1 = jobs[c.dataset.cancel]; if (j1) j1.cancelled = true; }
      var cp = ev.target.closest("[data-copy]");
      if (cp && navigator.clipboard) navigator.clipboard.writeText(cp.dataset.copy).then(function(){ cp.textContent = "kopiert"; }).catch(function(){});
      var rc = ev.target.closest("[data-rec]");
      if (rc){ var j2 = jobs[rc.dataset.rec]; if (j2 && j2.file) startRec(j2); }
      var pk = ev.target.closest("[data-pick]");
      if (pk){
        var parts = pk.dataset.pick.split(":");
        var j3 = jobs[parts[0]];
        if (!j3) return;
        var hit = j3.picks[parseInt(parts[1],10)];
        j3.picks = null;
        render(j3.id);
        runHit(j3, hit);
      }
    });
  });

  safe("Takt", function(){
    setInterval(function(){
      for (var id in jobs) if (["fertig","fehlgeschlagen","abgebrochen"].indexOf(jobs[id].state) === -1) render(id);
    }, 1000);
  });

  drawSettings();
  drawHistory();
  setStatus("bereit");
}
boot();
</script>
</body>
</html>
