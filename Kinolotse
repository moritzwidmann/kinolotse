/* ---------- Ablauf ---------- */
async function searchProvider(p, query, j){
  var variants = [query];
  var w = norm(query).split(" ").filter(Boolean);
  if (w.length > 1){ variants.push(w.slice(0,2).join(" ")); variants.push(w[0]); }
  var found = {};
  var baseHost = hostOf(p.base);

  for (var v=0; v<variants.length; v++){
    var page;
    try { page = await fetchPage(p.search.replace("{q}", encodeURIComponent(variants[v])), {timeout:40000}); }
    catch(e){ log(j, p.name + ": " + e.message, "w"); continue; }

    var links = linksIn(page.text, p.base);
    for (var i=0; i<links.length; i++){
      var link = links[i];
      if (p.must && p.must !== "/" && link.indexOf(p.must) === -1) continue;
      if (p.must === "/" && hostOf(link) !== baseHost) continue;
      if (found[link]) continue;
      var tail = decodeURIComponent((link.split("/").filter(Boolean).pop() || "").replace(/[-_]+/g," "));
      var s = sim(query, tail);
      if (s < S.threshold * 0.9) continue;
      found[link] = { provider:p.key, providerName:p.name, page:link, title:tail, year:yearOf(tail) || yearOf(link), s:s };
    }
    if (Object.keys(found).length) break;
  }
  var arr = [];
  for (var k in found) arr.push(found[k]);
  arr.sort(function(a,b){ return b.s - a.s; });
  return arr.slice(0, 6);
}

async function collectSources(hit, j){
  var queue = [[hit.page, 0]], seen = {}, out = {}, order = [];
  while (queue.length && Object.keys(seen).length < 10){
    var item = queue.shift(), page = item[0], depth = item[1];
    if (seen[page]) continue;
    seen[page] = 1;
    var res;
    try { res = await fetchPage(page, {timeout:40000}); } catch(e){ continue; }

    var links = linksIn(res.text, page);
    for (var i=0; i<links.length; i++){
      var link = links[i], h = matchHoster(link);
      if (h && !out[link]){ out[link] = { provider:hit.provider, providerName:hit.providerName, page:hit.page, title:hit.title, year:hit.year, hoster:h.key, hosterName:h.name, url:link }; order.push(link); }
      else if (/\.(mp4|webm)$/i.test(link) && !out[link]){ out[link] = { provider:hit.provider, providerName:hit.providerName, page:hit.page, title:hit.title, year:hit.year, hoster:"raw", hosterName:"Direkt", url:link }; order.push(link); }
    }
    if (depth < 1){
      for (var k=0; k<links.length; k++){
        if (hostOf(links[k]) === hostOf(page) && !seen[links[k]] && !/\.(jpg|png|gif|css|js|svg)$/i.test(links[k])) queue.push([links[k], depth+1]);
      }
    }
  }
  return order.map(function(l){ return out[l]; });
}

async function resolveSource(e){
  if (e.hoster === "raw") return { url:e.url, kind: /\.m3u8/i.test(e.url) ? "hls" : "mp4" };
  var page;
  try { page = await fetchPage(e.url, {timeout:30000, wantHtml:true}); }
  catch(err){ return { url:e.url, kind:"page" }; }
  var t = page.text;
  function grab(re){ var m = t.match(re); return m ? m[1].replace(/\\\//g,"/") : null; }
  function clean(u){ return (u && u.indexOf("//") === 0) ? "https:" + u : u; }

  if (e.hoster === "vidoza" || e.hoster === "luluvdo"){
    var u = grab(/<source[^>]+src=["']([^"']+\.mp4[^"']*)["']/i);
    if (u) return { url: clean(u), kind:"mp4" };
  }
  if (e.hoster === "streamtape"){
    var id = grab(/get_video\?id=([^&"']+)/);
    if (id){
      var exp = grab(/[?&]expires=([^&"']+)/), tok = grab(/token=([^&"']+)/), ip = grab(/[?&]ip=([^&"']+)/);
      return { url: "https://streamtape.com/get_video?id=" + id + (exp?"&expires="+exp:"") + (ip?"&ip="+ip:"") + (tok?"&token="+tok:""), kind:"mp4" };
    }
  }
  var hls = clean(grab(/["']((?:https?:)?\/\/[^"']+\.m3u8[^"']*)["']/i));
  if (hls) return { url:hls, kind:"hls" };
  var mp4 = clean(grab(/["']((?:https?:)?\/\/[^"']+\.mp4[^"']*)["']/i));
  if (mp4) return { url:mp4, kind:"mp4" };
  var bare = t.match(RX_BARE);
  if (bare) return { url: clean(bare[0]), kind: /\.m3u8/i.test(bare[0]) ? "hls" : "mp4" };
  return { url:e.url, kind:"page" };
}

async function verifyStream(r){
  if (r.kind === "page") return true;
  if (r.kind === "hls"){
    var pl = (await fetchPage(r.url, {timeout:25000, wantHtml:true})).text;
    if (pl.indexOf("#EXTM3U") !== 0) throw new Error("keine Playlist");
    if ((pl.match(/#EXTINF/g) || []).length < 3) throw new Error("zu wenige Segmente");
    return true;
  }
  var res = await fetch(r.url, {cache:"no-store"});
  if (!res.ok) throw new Error("HTTP " + res.status);
  var ct = (res.headers.get("content-type") || "").toLowerCase();
  if (ct.indexOf("text/html") !== -1) throw new Error("HTML statt Video");
  return true;
}

async function runSearch(j){
  var provs = S.providers.filter(function(p){ return p.enabled && p.search && p.must; });
  try {
    if (!provs.length) throw new Error("Kein Portal aktiv – Diagnose starten");
    j.eta = provs.length * Math.ceil(S.budget / Math.max(1, S.parallel));
    j.src = provs.map(function(p){ return { name:p.name, state:"wartet" }; });
    log(j, 'Suche „' + j.query + '" auf ' + provs.length + ' Portalen');
    set(j, {progress:4});

    var hits = [], i = 0;
    async function worker(){
      while (i < provs.length){
        var p = provs[i++];
        var row = null;
        j.src.forEach(function(s){ if (s.name === p.name) row = s; });
        if (row){ row.state = "sucht…"; render(j.id); }
        try {
          var r = await searchProvider(p, j.query, j);
          hits = hits.concat(r);
          if (row) row.state = r.length ? r.length + " Treffer" : "nichts";
          provResult(p.key, r.length > 0);
        } catch(e){
          if (row) row.state = "Fehler";
          log(j, p.name + ": " + e.message, "w");
          provResult(p.key, false);
        }
        set(j, {progress: 4 + Math.round(46 * (i / provs.length))});
      }
    }
    var runners = [];
    for (var w=0; w<Math.min(S.parallel, provs.length); w++) runners.push(worker());
    await Promise.all(runners);

    if (stopped(j)) return;
    if (!hits.length) throw new Error("Kein Treffer auf keinem Portal");
    var uniq = [], seen = {};
    hits.forEach(function(h){ if (!seen[h.page]){ seen[h.page] = 1; uniq.push(h); } });
    log(j, uniq.length + " Titeltreffer");
    if (uniq.length === 1 || uniq[0].s >= 0.95) return runHit(j, uniq[0]);
    set(j, {state:"auswahl", picks:uniq, progress:52, eta:null});
    log(j, "Titel bestätigen");
  } catch(e){
    set(j, {state:"fehlgeschlagen", error:e.message});
    log(j, e.message, "e");
  } finally {
    if ($("go")) $("go").disabled = false;
  }
}

async function runHit(j, hit){
  try {
    set(j, {state:"sammle", progress:55});
    var list = await collectSources(hit, j);
    if (!list.length) throw new Error("Keine Quelle gefunden");
    list.sort(function(a,b){
      var ha = matchHoster(a.url), hb = matchHoster(b.url);
      return ((hb?hb.score:30) * statOf(hit.provider, b.hoster)) - ((ha?ha.score:30) * statOf(hit.provider, a.hoster));
    });
    var per = {};
    list = list.filter(function(x){ per[x.hoster] = (per[x.hoster]||0)+1; return per[x.hoster] <= 3; }).slice(0, S.maxAttempts);
    j.found = list.length;
    log(j, list.length + " Quellen, prüfe…");
    set(j, {progress:62, eta:list.length * 4});

    for (var i=0; i<list.length; i++){
      if (stopped(j)) return;
      var e = list[i];
      try {
        var r = await resolveSource(e);
        await verifyStream(r);
        if (stopped(j)) return;
        var name = safeName(hit.title + (hit.year ? " (" + hit.year + ")" : "")) + (r.kind === "mp4" ? ".mp4" : ".m3u8");
        set(j, {state:"fertig", progress:100, eta:null, file:{ name:name, direct:r.url, kind:r.kind }});
        log(j, "OK über " + e.hosterName + (r.kind !== "mp4" ? " – Stream, „Aufnehmen" nutzen" : ""));
        statAdd(hit.provider, e.hoster, true);
        provResult(hit.provider, true);
        remember(hit, e, r);
        return;
      } catch(err){
        statAdd(hit.provider, e.hoster, false);
        log(j, e.hosterName + ": " + err.message, "w");
        await sleep(rnd(600,1400));
      }
    }
    throw new Error("Alle Quellen ausgeschöpft");
  } catch(e){
    set(j, {state:"fehlgeschlagen", error:e.message});
    log(j, e.message, "e");
  } finally {
    if ($("go")) $("go").disabled = false;
  }
}

async function runPage(j){
  try {
    var url = j.query.trim();
    if (!isHttp(url)) throw new Error("keine URL");
    log(j, "Werte Seite aus");
    var tail = decodeURIComponent((url.split("/").filter(Boolean).pop() || "film").replace(/[-_]+/g," "));
    return runHit(j, { provider:"extern", providerName:"Extern", page:url, title:tail, year:yearOf(url) });
  } catch(e){
    set(j, {state:"fehlgeschlagen", error:e.message});
    log(j, e.message, "e");
  } finally {
    if ($("go")) $("go").disabled = false;
  }
}

async function runRaw(j){
  try {
    var url = j.query.trim();
    if (!isHttp(url)) throw new Error("keine URL");
    var kind = /\.m3u8/i.test(url) ? "hls" : "mp4";
    await verifyStream({ url:url, kind:kind });
    set(j, {state:"fertig", progress:100, file:{ name:safeName(url.split("/").pop() || "video"), direct:url, kind:kind }});
    log(j, "Direktlink in Ordnung");
  } catch(e){
    set(j, {state:"fehlgeschlagen", error:e.message});
    log(j, e.message, "e");
  } finally {
    if ($("go")) $("go").disabled = false;
  }
}

/* ---------- Aufnahme ---------- */
var rec = null;
function pickMime(){
  var list = ["video/mp4;codecs=avc1.42E01E,mp4a.40.2","video/mp4","video/webm;codecs=vp9,opus","video/webm"];
  for (var i=0;i<list.length;i++){ try { if (MediaRecorder.isTypeSupported(list[i])) return list[i]; } catch(e){} }
  return "";
}
async function startRec(j){
  if (rec) return;
  var v = $("recvideo");
  $("recbox").className = "";
  $("recmsg").textContent = "Lade Stream…";
  rec = { chunks: [] };
  function load(cross){
    return new Promise(function(res, rej){
      v.crossOrigin = cross ? "anonymous" : null;
      v.src = j.file.direct;
      var t = setTimeout(function(){ rej(new Error("Timeout")); }, 25000);
      v.onloadedmetadata = function(){ clearTimeout(t); res(); };
      v.onerror = function(){ clearTimeout(t); rej(new Error("Ladefehler")); };
    });
  }
  try { try { await load(true); } catch(e){ await load(false); } }
  catch(e){ $("recmsg").textContent = "Stream lädt nicht: " + e.message; return; }

  var stream = v.captureStream ? v.captureStream() : v.mozCaptureStream();
  if (!stream){ $("recmsg").textContent = "Aufnahme nicht unterstützt – „Im Player" nutzen."; return; }
  var mime = pickMime(), mr;
  try { mr = new MediaRecorder(stream, mime ? {mimeType:mime, videoBitsPerSecond:6e6} : undefined); }
  catch(e){ $("recmsg").textContent = "Recorder-Fehler: " + e.message; return; }

  mr.ondataavailable = function(ev){ if (ev.data && ev.data.size) rec.chunks.push(ev.data); };
  mr.onstop = function(){
    var type = mime || "video/webm";
    var blob = new Blob(rec.chunks, {type:type});
    var ext = type.indexOf("mp4") !== -1 ? "mp4" : "webm";
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = safeName(j.query) + "." + ext;
    a.textContent = "Aufnahme speichern (" + ext + ", " + Math.round(blob.size/1048576) + " MB)";
    a.style.cssText = "display:block;margin-top:8px;color:#3ddc84;font-weight:700";
    $("recbar").appendChild(a);
    $("recmsg").textContent = "Fertig.";
    v.pause();
  };
  rec.mr = mr;
  v.muted = false;
  try { v.playbackRate = Math.max(1, Math.min(4, S.rate || 1)); } catch(e){}
  try { await v.play(); } catch(e){}
  mr.start(1000);
  $("recmsg").textContent = "Aufnahme läuft (" + (S.rate||1) + "×). Display an lassen.";
}
function stopRec(){ if (!rec) return; try { rec.mr.stop(); } catch(e){} rec.mr = null; }

